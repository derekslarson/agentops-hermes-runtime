# AgentOps compose-self-hosted development settings.
# Copy to .env and edit infrastructure-only values as needed.
# Raw model provider and app/integration secrets are intentionally not listed here;
# bootstrap stores those directly in the configured secret backend.

AGENTOPS_API_PORT=8710
AGENTOPS_POSTGRES_DB=agentops
AGENTOPS_POSTGRES_PASSWORD=agentops-dev-password
AGENTOPS_MINIO_ROOT_USER=agentopsminio
AGENTOPS_MINIO_ROOT_PASSWORD=agentops-minio-dev-password
AGENTOPS_ARTIFACT_BUCKET=agentops-artifacts
AGENTOPS_WORKER_MAX_CONCURRENT_RUNS=2
