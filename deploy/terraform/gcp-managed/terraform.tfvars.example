# AgentOps Hermes Runtime — GCP managed profile example settings.
# Copy to terraform.tfvars and edit project/region/domain/capacity values.
#
# NOTE: There are intentionally NO raw app/integration secret values here.
# Terraform only creates empty Secret Manager containers; bootstrap writes the
# real Slack/GitHub/Linear/Jira/model-provider values into the secret backend
# after apply, keeping raw values out of Terraform/OpenTofu state.

name_prefix = "agentops"
project     = "my-gcp-project"
region      = "us-central1"

# --- Public API endpoint (non-secret toggles) -------------------------------
# The default public API endpoint is the Cloud Run control-plane service URI
# (no load balancer / DNS is provisioned). Reachability without IAM auth is
# OPT-IN: set enable_public_invoker = true to grant allUsers roles/run.invoker
# on the control-plane only. A custom domain is OPTIONAL: set enable_custom_domain
# = true together with domain to create a Cloud Run domain mapping.
# enable_public_invoker = false
# enable_custom_domain  = false
# domain                = "agentops.example.com"

# --- Container images (non-secret refs) -------------------------------------
# Override with the runtime images you build/push. These are image references,
# not secret values.
control_plane_image = "agentops/hermes-control-plane:replace-me"
worker_image        = "agentops/hermes-worker:replace-me"
scheduler_image     = "agentops/hermes-scheduler:replace-me"

# Capacity.
desired_task_count  = 2
max_concurrent_runs = 2
min_task_count      = 1
max_task_count      = 10

# --- Bring-your-own-network (leave empty to create new) ---------------------
# existing_vpc_id     = "projects/my-gcp-project/global/networks/my-vpc"
# existing_subnet_ids = ["projects/my-gcp-project/regions/us-central1/subnetworks/my-subnet"]

# --- Bring-your-own-managed-resource (leave empty to create new) ------------
# existing_database_arn    = "my-gcp-project:us-central1:my-postgres"
# existing_artifact_bucket = "my-existing-artifacts-bucket"
# existing_secret_prefix   = "myorg-agentops"
